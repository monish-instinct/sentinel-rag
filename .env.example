# Copy to .env (git-ignored) and fill in one key. Without a key the app still
# runs with the extractive generator (no LLM).
SENTINEL_LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Any other OpenAI-compatible endpoint:
# SENTINEL_LLM_BASE_URL=http://localhost:11434/v1
# SENTINEL_LLM_MODEL=llama3.2
# SENTINEL_LLM_API_KEY=
